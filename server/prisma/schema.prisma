// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 1 — IT request categories (4 seeded: Account and Access, Hardware, Software, Network)
// ---------------------------------------------------------------------------
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 2 Feature D — Development Requester Context
// Simulates authenticated users before real JWT auth (Lab 3).
// isActive: false → excluded from the Dev Requester Selector (BR-11)
// ---------------------------------------------------------------------------
model Requester {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  department String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tickets    Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 2 Feature E — Ticket
// status defaults to OPEN (BR-04). Owned by exactly one Requester (BR-01).
// Attachments relation added in Feature G.
// ---------------------------------------------------------------------------
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  status      TicketStatus @default(OPEN)
  categoryId  Int
  requesterId Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  category  Category  @relation(fields: [categoryId],  references: [id])
  requester Requester @relation(fields: [requesterId], references: [id])
  attachments Attachment[]
}

// ---------------------------------------------------------------------------
// Lab 2 Feature G — Attachment (soft-delete, BR-08, BR-09)
// Hard-delete is never used; deletedAt + deleteReason records the removal.
// ---------------------------------------------------------------------------
model Attachment {
  id           Int       @id @default(autoincrement())
  ticketId     Int
  filename     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  deletedAt    DateTime?
  deleteReason String?
  createdAt    DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}
